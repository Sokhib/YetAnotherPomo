<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YetAnotherPomo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_ground</item>

        <!-- Android 12+ system splash screen: the Focus Lock mark on brand ground.
             The mark occupies the inner two thirds of ic_splash's 288dp box, which is
             what the platform's circular splash mask expects. -->
        <item name="android:windowSplashScreenBackground">@color/brand_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
